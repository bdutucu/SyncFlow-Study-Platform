# ─── SYNCFLOW backend environment template ────────────────────────────────────
# Copy to .env and fill in the two JWT secrets.
#
# Docker path (docker compose up --build):
#   Only JWT_ACCESS_SECRET and JWT_REFRESH_SECRET are required here.
#   DATABASE_URL, PORT, and BCRYPT_COST are set in docker-compose.yml and
#   will override what's in this file.
#
# Manual path (npm run dev):
#   Fill in all variables below.
# ─────────────────────────────────────────────────────────────────────────────

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (PostgreSQL 16 per DSD §2.3) ---
# Manual path: adjust user/password/host to match your local Postgres install.
# Docker path: docker-compose.yml sets this to the compose db service automatically.
DATABASE_URL=postgresql://syncflow:syncflow@localhost:5432/syncflow

# --- JWT secrets (DSD §3.5.5) ---
# REQUIRED for both Docker and manual paths.
# Generate two DIFFERENT secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=replace_me_with_a_random_at_least_32_byte_string
JWT_REFRESH_SECRET=replace_me_with_a_DIFFERENT_random_at_least_32_byte_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Security (DSD §3.5.5: bcrypt cost >= 10 in production) ---
BCRYPT_COST=10
